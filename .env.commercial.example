# Login: google for Sign in with Google; oidc retains the existing SaaS IdP flow.
REPLAY_LOGIN_PROVIDER=google
# Public OAuth Web application client ID; use the same ID in API and web builds.
REPLAY_GOOGLE_CLIENT_ID=
# Server-side account admission. Empty allowlists + 0 deny all Google accounts.
REPLAY_GOOGLE_ALLOWED_EMAILS=
REPLAY_GOOGLE_ALLOWED_SUBJECTS=
# 1 admits all verified Google accounts as separate ordinary operators.
# Existing email/subject allowlists do not restrict signup when this is 1.
REPLAY_GOOGLE_ALLOW_SIGNUPS=0
# API only: explicit site administrator emails; empty grants no member-management access.
# This does not expand Google admission. Set only approved, Google-verified accounts.
# Never include this account list in web build environment/public variables.
REPLAY_SITE_ADMIN_EMAILS=

# Secret values belong in the deployment secret store; never commit a filled copy.
REPLAY_MODE=production
REPLAY_VERSION=replace-with-release-sha
REPLAY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/replay?sslmode=require
REPLAY_PUBLIC_URL=https://api.example.com
REPLAY_ORIGINS=https://replay.example.com
REPLAY_CONTROL_TOKEN=
REPLAY_CALLBACK_KEY=
REPLAY_BUCKET=
REPLAY_KMS_KEY_ID=
REPLAY_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
# Workload identity. IAM trust must match this exact API project/environment.
REPLAY_AWS_AUTH_MODE=vercel_oidc
REPLAY_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/replay-api
REPLAY_AWS_OIDC_ISSUER=https://oidc.vercel.com/TEAM
REPLAY_AWS_OIDC_AUDIENCE=https://vercel.com/TEAM
REPLAY_AWS_OIDC_SUBJECT=owner:TEAM:project:replay-api:environment:production
REPLAY_AUTH_MODE=production
REPLAY_AUTH_ISSUER=https://identity.example.com
REPLAY_AUTH_AUDIENCE=replay-api
REPLAY_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
REPLAY_AUTH_TENANT_CLAIM=tenant_id
REPLAY_AUTH_ROLES_CLAIM=roles
REPLAY_AUTH_MEMBERSHIP_CLAIM=tenant_memberships
REPLAY_MAX_UPLOAD_BYTES=524288000
# File-result ceiling, separate from source upload; must fit S3 single PUT (5 GiB).
# Admission also reserves tenant storage before starting a file-result job.
REPLAY_MAX_OUTPUT_BYTES=5368709120
REPLAY_MAX_DURATION=14400
REPLAY_MAX_STORAGE_BYTES=10737418240
REPLAY_TENANT_CONCURRENCY=4
REPLAY_GLOBAL_CONCURRENCY=4
REPLAY_MAX_PENDING_JOBS=50
REPLAY_RETENTION_DAYS=30
REPLAY_VALIDATION_TIMEOUT=600
REPLAY_LEASE_SECONDS=90
REPLAY_RESERVATION_GRACE=120
REPLAY_WORKER_MAX_SECONDS=18000
REPLAY_DRAINING=0
# Web / dispatcher project. These OIDC values are public configuration, never client secrets.
REPLAY_COMMERCIAL=1
REPLAY_API_URL=https://api.example.com
REPLAY_OIDC_AUTHORITY=https://identity.example.com
REPLAY_OIDC_CLIENT_ID=replay-web
REPLAY_OIDC_AUDIENCE=replay-api
REPLAY_OIDC_SCOPE=openid profile offline_access
REPLAY_CONTROL_URL=https://api.example.com
REPLAY_WORKER_SNAPSHOT_ID=
CRON_SECRET=
# Optional receiver must deduplicate by Idempotency-Key and accept {service,id,code,count,created}.
REPLAY_ALERT_WEBHOOK_URL=
REPLAY_ALERT_WEBHOOK_TOKEN=
