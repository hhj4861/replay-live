# Login: google for Sign in with Google; oidc retains the existing SaaS IdP flow.
REPLAY_LOGIN_PROVIDER=google
# Public OAuth Web application client ID; use the same ID in API and web builds.
REPLAY_GOOGLE_CLIENT_ID=
# Server-side account admission. Empty allowlists + 0 deny all Google accounts.
REPLAY_GOOGLE_ALLOWED_EMAILS=
REPLAY_GOOGLE_ALLOWED_SUBJECTS=
# Set 1 to allow any verified Google account; each gets its own operator tenant.
# This overrides the admission restriction of the allowlists, not site-admin policy.
REPLAY_GOOGLE_ALLOW_SIGNUPS=0

# Configure in the separate API project's server environment; do not bundle.
REPLAY_MODE=production
REPLAY_VERSION=replace-with-immutable-commit
REPLAY_DATABASE_URL=postgresql+psycopg://replace-in-secret-store
REPLAY_PUBLIC_URL=https://api.example.com
REPLAY_ORIGINS=https://app.example.com
REPLAY_CONTROL_TOKEN=replace-with-independent-random-secret-at-least-32-characters
REPLAY_CALLBACK_KEY=replace-with-a-different-random-secret-at-least-32-characters
REPLAY_BUCKET=replace-private-s3-bucket
REPLAY_KMS_KEY_ID=arn:aws:kms:ap-northeast-2:ACCOUNT:key/KEY
REPLAY_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
# Exact workload identity for this API project/environment; no wildcard trust.
REPLAY_AWS_AUTH_MODE=vercel_oidc
REPLAY_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/replay-api
REPLAY_AWS_OIDC_ISSUER=https://oidc.vercel.com/TEAM
REPLAY_AWS_OIDC_AUDIENCE=https://vercel.com/TEAM
REPLAY_AWS_OIDC_SUBJECT=owner:TEAM:project:replay-api:environment:production
REPLAY_AUTH_MODE=production
REPLAY_AUTH_ISSUER=https://identity.example.com
REPLAY_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
REPLAY_AUTH_AUDIENCE=replay-api
REPLAY_AUTH_TENANT_CLAIM=tenant_id
REPLAY_AUTH_ROLES_CLAIM=roles
REPLAY_RESERVATION_GRACE=120
REPLAY_MAX_UPLOAD_BYTES=524288000
REPLAY_MAX_OUTPUT_BYTES=5368709120
REPLAY_MAX_STORAGE_BYTES=10737418240
REPLAY_DRAINING=1
# Enable only after the dispatcher has the shared proxy and EJS-capable snapshot.
REPLAY_SERVER_IMPORTS=0
