{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "REPLAY_COMMERCIAL=1 npm run build:vercel",
  "outputDirectory": "dist-vercel",
  "functions": {
    "api/dispatch.ts": { "maxDuration": 300 },
    "api/blob-control.ts": { "maxDuration": 120 },
    "api/session.ts": { "maxDuration": 120 }
  },
  "crons": [{ "path": "/api/dispatch", "schedule": "*/1 * * * *" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Frame-Options", "value": "DENY" }
  ] }]
}
