# Login: google for Sign in with Google; oidc retains the existing SaaS IdP flow.
REPLAY_LOGIN_PROVIDER=google
# Public OAuth Web application client ID; use the same ID in API and web builds.
REPLAY_GOOGLE_CLIENT_ID=

# These first values are public build inputs. No client secret is used by PKCE.
REPLAY_COMMERCIAL=1
REPLAY_API_URL=https://api.example.com
REPLAY_OIDC_AUTHORITY=https://identity.example.com
REPLAY_OIDC_CLIENT_ID=replace-public-client-id
REPLAY_OIDC_AUDIENCE=replay-api
REPLAY_OIDC_SCOPE=openid profile offline_access
# The following are server-only dispatcher environment variables.
REPLAY_CONTROL_URL=https://api.example.com
REPLAY_CONTROL_TOKEN=replace-with-api-control-token
CRON_SECRET=replace-with-independent-random-secret-at-least-32-characters
REPLAY_VERSION=replace-with-immutable-commit
REPLAY_WORKER_SNAPSHOT_ID=replace-with-reviewed-snapshot-id
# Optional HTTPS alert receiver. Deduplicate on Idempotency-Key before replying 2xx.
# Receives only {service,id,code,count,created}; token is never a public build input.
REPLAY_ALERT_WEBHOOK_URL=
REPLAY_ALERT_WEBHOOK_TOKEN=
