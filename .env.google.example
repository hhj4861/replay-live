# Local Google login. Copy to .env.google.local and fill in your own values.
# No Google client secret is used or accepted by the preview launcher.
# Google Cloud Authorized JavaScript origins: http://localhost and http://localhost:13100
REPLAY_GOOGLE_CLIENT_ID=
REPLAY_GOOGLE_ALLOWED_EMAILS=
REPLAY_GOOGLE_ALLOWED_SUBJECTS=
# Set to 1 to admit all verified Google accounts as separate ordinary operators.
# Existing email/subject allowlists then remain compatible but do not restrict signup.
REPLAY_GOOGLE_ALLOW_SIGNUPS=0
# Optional server-only site administrators, comma separated; empty grants none.
# Accounts must also pass the admission policy above and Google email ownership checks.
# This local preview setting is never passed to the frontend build or production.
REPLAY_SITE_ADMIN_EMAILS=
